digraph G { rankdir=LR; graph [fontname="Arial", bgcolor="white", label="Design B - Partial decomposition", labelloc=t, fontsize=20]; node [shape=record, fontname="Arial", fontsize=10, style=filled, fillcolor="#F6F7FB"]; edge [fontname="Arial", fontsize=9]; sender [label="{PARTIAL_SENDER|SenderID (PK)\lSenderName\lRouteGroup\l}"]; service [label="{PARTIAL_SERVICE|ServiceID (PK)\lServiceCode (UNIQUE)\lServiceName\lVolumeWeight\l}"]; obs [label="{PARTIAL_OBSERVATION|SenderID (PK, FK)\lServiceID (PK, FK)\lDispatchWave (PK)\lCoordinatorID\lCoordinatorName (repeated)\lHub (repeated)\lCompletion\lServiceBand (derived/repeated)\lRouteFactor (derived/repeated)\l}"]; sender -> obs [label="SenderID"]; service -> obs [label="ServiceID"]; }
