digraph G { rankdir=LR; splines=ortho; graph [fontname="Arial", bgcolor="white", label="Design C - BCNF source-of-truth schema", labelloc=t, fontsize=20, nodesep=.35, ranksep=.65]; node [shape=record, fontname="Arial", fontsize=9, style=filled, fillcolor="#F6F7FB"]; edge [fontname="Arial", fontsize=8]; sender [label="{SENDER|SenderID (PK)\lSenderName\lRouteGroup\l}"]; service [label="{SERVICE|ServiceID (PK)\lServiceCode (UNIQUE)\lServiceName\lVolumeWeight\l}"]; coord [label="{COORDINATOR|CoordinatorID (PK)\lCoordinatorName\lHub\l}"]; assignment [label="{ASSIGNMENT|SenderID (PK, FK)\lServiceID (PK, FK)\lCoordinatorID (FK)\l}"]; obs [label="{OBSERVATION|SenderID (PK, FK)\lServiceID (PK, FK)\lDispatchWave (PK)\lCompletion\l}"]; cp [label="{COMPLETION_POLICY|Completion (PK)\lServiceBand\l}"]; bp [label="{SERVICE_BAND_POLICY|ServiceBand (PK)\lRouteFactor\l}"]; sender -> assignment [label="1:N"]; service -> assignment [label="1:N"]; coord -> assignment [label="1:N"]; assignment -> obs [label="1:N (4 waves)"]; cp -> obs [label="Completion policy lookup", style=dashed]; bp -> cp [label="ServiceBand", style=dashed]; }
