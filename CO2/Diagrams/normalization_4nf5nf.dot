digraph G { rankdir=LR; graph [fontname="Arial", bgcolor="white", label="Independent MVDs (4NF) and three-way JD (5NF)", labelloc=t, fontsize=18]; node [shape=record, fontname="Arial", fontsize=10, style=filled, fillcolor="#F6F7FB"]; edge [fontname="Arial", fontsize=9]; svc [label="{SERVICE|ServiceID (PK)\lServiceName\l}"]; modes [label="{SERVICE_MODE|ServiceID (PK, FK)\lTransportMode (PK)\l}"]; docs [label="{SERVICE_DOCUMENT|ServiceID (PK, FK)\lDocumentType (PK)\l}"]; auth [label="{AUTHORIZATION_TRIPLE|OperatorID\lItemID\lChannelID\lComposite PK\l}"]; oi [label="{OPERATOR_ITEM_APPROVAL|OperatorID\lItemID\l}"]; oc [label="{OPERATOR_CHANNEL_APPROVAL|OperatorID\lChannelID\l}"]; ic [label="{ITEM_CHANNEL_APPROVAL|ItemID\lChannelID\l}"]; svc -> modes [label="1:N"]; svc -> docs [label="1:N"]; auth -> oi [label="projection"]; auth -> oc [label="projection"]; auth -> ic [label="projection"]; }
