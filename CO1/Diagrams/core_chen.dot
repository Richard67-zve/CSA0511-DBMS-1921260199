digraph MuseumER {
  graph [rankdir=LR, splines=ortho, nodesep=0.42, ranksep=0.85, bgcolor="white", pad=0.25, fontname="Arial", labelloc="t", label="MERIDIAN MUSEUM - PREFERRED CHEN-STYLE ER MODEL (BASELINE / TASKS 1-11)", fontsize=22];
  node [fontname="Arial", fontsize=10, color="#164A72", penwidth=1.4];
  edge [fontname="Arial", fontsize=9, color="#44566C", penwidth=1.1, arrowsize=0.7];
  Party [shape=box, style="rounded,filled", fillcolor="#DDEBF7", label="PARTY\nPartyID (PK)\nPartyKind"];
  Person [shape=box, style="rounded,filled", fillcolor="#DDEBF7", label="PERSON\nPartyID (PK/FK)\nFirstName, MiddleName, LastName\nEmail"];
  Organization [shape=box, style="rounded,filled", fillcolor="#DDEBF7", label="ORGANIZATION\nPartyID (PK/FK)\nLegalName, RegistrationNo"];
  Phone [shape=box, style="rounded,filled", fillcolor="#EAF3F8", label="PERSON_PHONE\nPartyID + Type + Number (PK)\nPhoneNumber"];
  Lender [shape=box, style="rounded,filled", fillcolor="#DDEBF7", label="LENDER\nPartyID (PK/FK)\nLenderCode (AK), JoinedOn"];
  Employee [shape=box, style="rounded,filled", fillcolor="#DDEBF7", label="EMPLOYEE\nPersonID (PK/FK)\nEmployeeNo (AK), Role"];
  Curator [shape=box, style="rounded,filled", fillcolor="#EAF3F8", label="CURATOR\nPersonID (PK/FK)\nSpecialisation"];
  Registrar [shape=box, style="rounded,filled", fillcolor="#EAF3F8", label="REGISTRAR\nPersonID (PK/FK)\nClearanceLevel"];
  Loan [shape=box, style="rounded,filled", fillcolor="#DDEBF7", label="LOAN\nLoanID (PK), LoanNo (AK)\nLoanDate, ExpectedReturnDate\nActualReturnDate, Status"];
  LoanObject [shape=box, style="rounded,filled", fillcolor="#DDEBF7", label="LOAN_OBJECT\nLoanID + ArtifactID (PK)\nCustodyStart, CustodyEnd\nLoanLineValue"];
  Artifact [shape=box, style="rounded,filled", fillcolor="#DDEBF7", label="ARTIFACT\nArtifactID (PK), AccessionNo (AK)\nTitle, EstimatedValue\nOwnerPartyID (FK)"];
  Unit [shape=box, style="rounded,filled", fillcolor="#EAF3F8", label="COLLECTION_UNIT\nUnitID (PK), UnitName (AK)"];
  Type [shape=box, style="rounded,filled", fillcolor="#EAF3F8", label="COLLECTION_TYPE\nTypeID (PK), TypeName (AK)"];
  Exhibit [shape=box, style="rounded,filled", fillcolor="#DDEBF7", label="EXHIBITION\nExhibitionID (PK), Code (AK)\nName, OpensOn, ClosesOn"];
  Slot [shape=box, style="rounded,filled", fillcolor="#EAF3F8", label="DISPLAY_SLOT (WEAK)\nExhibitionID + SlotNo (PK)\nGallery, Position"];
  Placement [shape=box, style="rounded,filled", fillcolor="#EAF3F8", label="PLACEMENT\nPlacementID (PK)\nLoanID + ArtifactID (FK)\nExhibitionID + SlotNo (FK)\nPlacementStart, PlacementEnd"];
  Contact [shape=box, style="rounded,filled", fillcolor="#EAF3F8", label="NOTIFICATION_CONTACT\nContactID (PK)\nPersonID XOR OrganizationID\nLabel, Email, Phone"];
  LoanContact [shape=box, style="rounded,filled", fillcolor="#EAF3F8", label="LOAN_NOTIFICATION_CONTACT\nLoanID + ContactID + Purpose (PK)"];
  Report [shape=box, style="rounded,filled", fillcolor="#DDEBF7", label="CONDITION_REPORT\nReportID (PK)\nLoanID + ArtifactID (FK)\nReportDate, Stage, ConditionCode\nInspector, Notes"];
  OwnerParty [shape=box, style="rounded,filled", fillcolor="#EAF3F8", label="OWNER PARTY\nPartyID (FK to PARTY)\nOne current owner in baseline"];

  ISA1 [shape=triangle, orientation=270, label="ISA", width=0.65, height=0.55, style=filled, fillcolor="#FFF2CC"];
  ISA2 [shape=triangle, orientation=270, label="ISA", width=0.65, height=0.55, style=filled, fillcolor="#FFF2CC"];
  ISA3 [shape=triangle, orientation=270, label="ISA", width=0.65, height=0.55, style=filled, fillcolor="#FFF2CC"];
  owns [shape=diamond, style=filled, fillcolor="#FCE4D6", label="OWNS"];
  hasPhone [shape=diamond, style=filled, fillcolor="#FCE4D6", label="HAS"];
  lenderLoan [shape=diamond, style=filled, fillcolor="#FCE4D6", label="BORROWS"];
  curLoan [shape=diamond, style=filled, fillcolor="#FCE4D6", label="RESPONSIBLE FOR"];
  regLoan [shape=diamond, style=filled, fillcolor="#FCE4D6", label="PROCESSES"];
  contains [shape=diamond, style=filled, fillcolor="#FCE4D6", label="CONTAINS"];
  item [shape=diamond, style=filled, fillcolor="#FCE4D6", label="IS LOANED"];
  unitRel [shape=diamond, style=filled, fillcolor="#FCE4D6", label="CLASSIFIES"];
  typeRel [shape=diamond, style=filled, fillcolor="#FCE4D6", label="HAS TYPE"];
  slotRel [shape=diamond, style=filled, fillcolor="#FCE4D6", label="IDENTIFIES"];
  placementRel [shape=diamond, style=filled, fillcolor="#FCE4D6", label="PLACED IN"];
  reportRel [shape=diamond, style=filled, fillcolor="#FCE4D6", label="HAS EVIDENCE"];
  contactRel [shape=diamond, style=filled, fillcolor="#FCE4D6", label="NOTIFIED BY"];
  ownerRel [shape=diamond, style=filled, fillcolor="#FCE4D6", label="LEGALLY OWNED BY"];

  Party -> ISA1 [arrowhead=none]; ISA1 -> Person [arrowhead=none, label="person"]; ISA1 -> Organization [arrowhead=none, label="organization"];
  Person -> ISA2 [arrowhead=none]; ISA2 -> Employee [arrowhead=none]; Person -> Lender [label="role may overlap"];
  Employee -> ISA3 [arrowhead=none]; ISA3 -> Curator [arrowhead=none, label="disjoint / total"]; ISA3 -> Registrar [arrowhead=none];
  Person -> hasPhone [arrowhead=none, label="1"]; hasPhone -> Phone [arrowhead=none, label="0..N"];
  Lender -> lenderLoan [arrowhead=none, label="1"]; lenderLoan -> Loan [arrowhead=none, label="0..N"];
  Curator -> curLoan [arrowhead=none, label="1"]; curLoan -> Loan [arrowhead=none, label="0..N"];
  Registrar -> regLoan [arrowhead=none, label="1"]; regLoan -> Loan [arrowhead=none, label="0..N"];
  Loan -> contains [arrowhead=none, label="1"]; contains -> LoanObject [arrowhead=none, label="1..N"];
  Artifact -> item [arrowhead=none, label="1"]; item -> LoanObject [arrowhead=none, label="0..N"];
  Unit -> unitRel [arrowhead=none, label="1"]; unitRel -> Artifact [arrowhead=none, label="0..N"];
  Type -> typeRel [arrowhead=none, label="1"]; typeRel -> Artifact [arrowhead=none, label="0..N"];
  Exhibit -> slotRel [arrowhead=none, label="1"]; slotRel -> Slot [arrowhead=none, label="1..N"];
  LoanObject -> placementRel [arrowhead=none, label="1"]; placementRel -> Placement [arrowhead=none, label="0..N"];
  Slot -> placementRel [arrowhead=none, label="1"]; 
  LoanObject -> reportRel [arrowhead=none, label="1"]; reportRel -> Report [arrowhead=none, label="0..N"];
  Loan -> contactRel [arrowhead=none, label="1"]; contactRel -> LoanContact [arrowhead=none, label="0..N"]; LoanContact -> Contact [arrowhead=none, label="N"];
  Party -> OwnerParty [style=dashed, arrowhead=none]; Artifact -> ownerRel [arrowhead=none, label="1"]; ownerRel -> OwnerParty [arrowhead=none, label="N"];
}
